{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/company/sdlc/managed_write_scope.py",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
